# ISPadmin — PPPoE via RADIUS. Copy to .env, fill in, then: docker compose up -d --build
# Without a .env file nothing changes: ISPadmin keeps running on SQLite with /ppp secret PPPoE.

# Starts the extra `db` (MariaDB) and `freeradius` containers.
COMPOSE_PROFILES=radius

# RADIUS needs MySQL/MariaDB — FreeRADIUS reads the same database.
# Existing SQLite data: migrate it first, see README "Moving from SQLite to MySQL".
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ispadmin
DB_USER=ispadmin
DB_PASS=change-me-long-random

ISPADMIN_RADIUS=1

# Address FreeRADIUS listens on (UDP 1812/1813): the management / NAS-facing IP of this host.
# Never a public address. 127.0.0.1 = only reachable from this host (fine for a first test).
RADIUS_BIND=127.0.0.1
# The same address as the app sees it (used by the "RADIUS test" button).
RADIUS_SERVER=127.0.0.1
# Address the MikroTiks use to reach FreeRADIUS — printed into the generated router config.
RADIUS_ADDRESS=
# Secret between ISPadmin and its own FreeRADIUS (test button only). Long and random.
RADIUS_LOCAL_SECRET=change-me-long-random-too
# Source IP for CoA / disconnect packets, if the host has several addresses.
RADIUS_COA_SOURCE=
# Require Message-Authenticator in Access-Requests (BlastRADIUS hardening). Set to yes when all
# routers run RouterOS 7.15 or newer; older RouterOS does not send it and would be rejected.
RADIUS_REQUIRE_MA=no

# restrict = unpaid/suspended get a session with the status address-list; reject = no session
ISPADMIN_RADIUS_MODE=restrict
# cleartext = PAP+CHAP+MS-CHAPv2; nt = NT hash, PAP+MS-CHAPv2 only (CHAP fails)
ISPADMIN_RADIUS_PW_STORAGE=cleartext
# Optional throttle / walled-garden filter for restricted sessions (empty = not sent)
ISPADMIN_RADIUS_RESTRICT_RATE=
ISPADMIN_RADIUS_FILTER_ID=
# Framed-Pool for customers without a static IP (empty = the PPP profile decides)
ISPADMIN_RADIUS_POOL=
# Acct-Interim-Interval sent to the NAS, seconds
ISPADMIN_RADIUS_INTERIM=300
# Status change on a live session: disconnect (PoD, default) or coa
ISPADMIN_RADIUS_COA_STATUS=disconnect

# Time zone for the database and FreeRADIUS (session times in radacct).
# Must be the SAME zone the app uses — normally the server's own (see `timedatectl`),
# e.g. Europe/Bratislava or Australia/Perth. Empty = UTC.
TZ=
